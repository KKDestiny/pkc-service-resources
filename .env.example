NODE_ENV=development

APP_DEBUG_MODE=false
APP_NAME=service-resources
APP_PORT=6003

APP_ROUTE="/resources"
APP_STATICS_PATH="/resources/statics"
APP_BOOKS_PATH="/resources/books"
APP_ARTS_PATH="/resources/arts"
APP_PROTECTED_PATH="/resources/protects"

APP_MONGO_DEBUG_MODE=false
APP_MONGO_PORT=27017
APP_MONGO_HOST=localhost
APP_MONGO_NAME=account
APP_MONGO_AUTH=admin
APP_MONGO_USER=admin
APP_MONGO_PASS=linxiaozhou

APP_REDIS_PORT=6379
APP_REDIS_HOST=localhost

# 后端服务
BLOG_SERVICE_ENDPOINT=https://linxiaozhou.com/blog
PERSONAL_SERVICE_ENDPOINT=https://linxiaozhou.com/personal
TASKS_SERVICE_ENDPOINT=https://linxiaozhou.com/tasks

API_ACCOUNTS_ENDPOINT="http://localhost:6001/accounts"

# 审计元数据 HMAC 密钥：与 account 服务（以及其它下游服务）保持一致
# 生成：openssl rand -hex 32
# 留空时 AppKey 调用仍可鉴权，但 account 审计日志只会记录 /open/me 自身路径。
APP_AUDIT_HMAC_SECRET=
